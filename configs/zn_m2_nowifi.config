# ZN M2 seed config v1.0 (2026-11-03) — qualcommax/ipq60xx, wired-only
# Source: VIKINGYFY/immortalwrt (main). Symbols verified 2026-11-03:
# - Device form CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2 (multi-profile)
# - PassWall options verified against Openwrt-Passwall/openwrt-passwall
#   luci-app-passwall/Makefile, PKG_VERSION 26.10.29
# The workflow prefers the source tree's own WIFI-NO seed when one is shipped;
# this file's package selections are appended either way. `make defconfig` resolves the rest.

# ---- Target: ZN M2 only, per-device rootfs ----
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# ---- No WiFi (user decision: wired PPPoE box, no WiFi, no USB) ----
# CONFIG_PACKAGE_ipq-wifi-zn_m2 is not set
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_luci-app-wizard is not set

# ---- LuCI base + items from the user's current menus ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-filetransfer-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# ---- Theme: Argon (user requirement; set as default via files/etc/uci-defaults) ----
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ---- User must-haves ----
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_ddnsto=y

# ---- PassWall (latest from official feed, all cores baked in) ----
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y
# Geoview stays at its aarch64 default (y): sing-box rule conversion needs it.
# Turned OFF for size / single-DNS-chain purity (user: PassWall first, no MosDNS in v1):
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Tuic_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# NOTE: chinadns-ng, dns2socks, microsocks, tcping are hard deps of luci-app-passwall.

# ---- NOT included in v1 ----
# MosDNS — user decision 2026-11-03: not in v1, PassWall stability first.
# Also excluded: luci-app-nps, luci-app-openvpn, luci-app-ddns, luci-app-gecoosac,
# luci-app-turboacc (fw3-era; NSS hardware acceleration replaces it on this target).
